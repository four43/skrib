#!/bin/bash
set -euo pipefail

DIR="$(dirname "$(readlink -f "$0")")"
cd "$DIR/../"

IMAGE_NAME="skrib:latest"
TAR_FILE="/tmp/skrib-image.tar"
REMOTE_HOST="ursa-minor"

echo "Building docker image..."
docker build --build-arg INSTALL_DEV_DEPS=0 -t "$IMAGE_NAME" .

echo "Saving image to $TAR_FILE..."
docker save "$IMAGE_NAME" -o "$TAR_FILE"

echo "Copying image to $REMOTE_HOST..."
scp "$TAR_FILE" "$REMOTE_HOST":"$TAR_FILE"

echo "Loading image on $REMOTE_HOST..."
ssh "$REMOTE_HOST" "docker load -i $TAR_FILE && rm $TAR_FILE"

rm "$TAR_FILE"

REMOTE_DIR="/opt/skrib-chat"

echo "Copying docker-compose.prod.yml to $REMOTE_HOST..."
ssh "$REMOTE_HOST" "mkdir -p $REMOTE_DIR"
scp "$DIR/docker-compose.prod.yml" "$REMOTE_HOST":"$REMOTE_DIR/docker-compose.yml"

echo "Starting services on $REMOTE_HOST..."
ssh "$REMOTE_HOST" "cd $REMOTE_DIR && docker compose up -d --force-recreate"

echo "Done. $IMAGE_NAME running on $REMOTE_HOST:8010."
