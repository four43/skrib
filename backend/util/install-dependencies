#!/bin/bash
# Install Python dependencies with uv, from uv.lock.
#
# Usage:
#   ./util/install-dependencies              # runtime dependencies only
#   ./util/install-dependencies dev          # ... plus the "dev" extra
#   ./util/install-dependencies dev,other    # comma-separated list of extras
#
# On a host this creates backend/.venv, which the e2e harness finds via
# findVenvPython() in frontend/tests/e2e/fixtures.js. In the container the
# Dockerfile sets UV_PROJECT_ENVIRONMENT=/usr/local so it installs into the
# system prefix instead — the container is the isolation boundary.
#
# The project itself is deliberately not installed as a package
# (--no-install-project): skrib and skrib_plugin_sdk are imported from this
# directory via cwd or PYTHONPATH.
#
# Set UV_FROZEN=1 (the Dockerfile does) to fail rather than update uv.lock.
set -euo pipefail

if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
    sed -n '2,18p' "$0" | sed 's/^#\{1\} \{0,1\}//'
    exit 0
fi

cd "$(dirname "$(readlink -f "$0")")/.."

args=(sync --no-install-project)
if [[ -n "${1:-}" ]]; then
    IFS=',' read -ra extras <<< "$1"
    for extra in "${extras[@]}"; do
        args+=(--extra "$extra")
    done
fi

echo "Installing dependencies: uv ${args[*]}" >&2
exec uv "${args[@]}"
