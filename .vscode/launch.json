{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run API Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "skrib.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONUNBUFFERED": "1",
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "jinja": true
    },
    {
      "name": "Plugins: Start All",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/util/run-plugins.py",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "SKRIB_BUS_URL": "ws://127.0.0.1:9000"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "FastAPI: Run API Server (No Reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "skrib.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "jinja": true
    }
  ]
}
