{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend Dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "problemMatcher": [],
      "isBackground": true,
      "options": {
        "env": {
          "VITE_DEBUG": "true"
        }
      }
    },
    {
      "label": "Pinggy Tunnel",
      "type": "shell",
      "command": "ssh -p 443 -R0:localhost:5173 qr@free.pinggy.io",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Seed Database",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python",
      "args": ["${workspaceFolder}/backend/scripts/seed.py"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    }
  ]
}
