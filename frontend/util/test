#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Build frontend so the backend can serve it from dist/
npm run build

echo "=== DOM tests ==="
npx playwright test --project=dom

echo ""
echo "=== E2E tests ==="

# SKRIB_TEST_DATA_DIR just needs to be set (truthy) to enable the e2e project.
# Each Playwright worker creates its own temp data dir via the _workerBackend fixture.
SKRIB_TEST_DATA_DIR=1 npx playwright test --project=e2e
